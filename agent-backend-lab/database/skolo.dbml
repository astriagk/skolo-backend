Table users {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  phone_number varchar(20) [unique, not null]
  user_type enum [not null, note: 'parent or driver']
  is_active boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp
  last_login timestamp
  fcm_token varchar(255) [note: 'Firebase Cloud Messaging token']

  indexes {
    phone_number
    user_type
  }
}

Table parents {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  user_id ObjectId [unique, not null, ref: - users._id]
  name varchar(100) [not null]
  email varchar(100)
  photo_url varchar(255)
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    email
  }
}

Table parent_addresses {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  parent_id ObjectId [not null, ref: > parents._id]
  address_line1 varchar(255) [not null]
  address_line2 varchar(255)
  city varchar(100) [not null]
  state varchar(100) [not null]
  pincode varchar(10)
  latitude decimal(10,8) [not null]
  longitude decimal(11,8) [not null]
  is_primary boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    parent_id
    (latitude, longitude)
  }
}

Table drivers {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  user_id ObjectId [unique, not null, ref: - users._id]
  driver_unique_id varchar(20) [unique, not null, note: 'Unique ID for parents to search/add driver']
  name varchar(100) [not null]
  email varchar(100)
  photo_url varchar(255)
  vehicle_type enum [not null, note: 'van, auto, bus']
  vehicle_number varchar(20) [not null]
  vehicle_capacity int [not null]
  current_student_count int [default: 0, note: 'Current number of active students']
  approval_status enum [default: 'pending', note: 'pending, approved, rejected']
  approved_by ObjectId [note: 'References admin_portal._id']
  approved_at timestamp
  rejection_reason text
  is_available boolean [default: true]
  rating decimal(3,2) [default: 0.00]
  total_trips int [default: 0]
  school_id ObjectId [ref: > schools._id, note: 'School employment - if employed by a school']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    approval_status
    vehicle_type
    is_available
    driver_unique_id
  }

  Note: 'Driver profile. Documents and addresses are in separate tables.'
}

Table driver_addresses {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  driver_id ObjectId [not null, ref: > drivers._id]
  address_line1 varchar(255) [not null]
  address_line2 varchar(255)
  city varchar(100) [not null]
  state varchar(100) [not null]
  pincode varchar(10)
  latitude decimal(10,8) [not null]
  longitude decimal(11,8) [not null]
  is_primary boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    driver_id
    (latitude, longitude)
  }

  Note: 'Driver can have multiple addresses, but usually one primary (home).'
}

Table driver_documents {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  driver_id ObjectId [not null, ref: > drivers._id]
  driving_license_number varchar(50) [not null]
  driving_license_photo_url varchar(255)
  vehicle_license_number varchar(50) [not null]
  vehicle_license_photo_url varchar(255)
  insurance_number varchar(50)
  insurance_photo_url varchar(255)
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    driver_id
  }

  Note: 'Stores driver document details. Can be extended for document history.'
}

Table schools {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  school_name varchar(200) [not null]
  address varchar(255) [not null]
  city varchar(100) [not null]
  state varchar(100) [not null]
  latitude decimal(10,8) [not null]
  longitude decimal(11,8) [not null]
  contact_number varchar(20)
  email varchar(100)
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    city
    (latitude, longitude)
  }
}

Table students {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  parent_id ObjectId [not null, ref: > parents._id]
  school_id ObjectId [not null, ref: > schools._id]
  student_name varchar(100) [not null]
  class varchar(20) [not null]
  section varchar(10)
  roll_number varchar(20)
  photo_url varchar(255)
  date_of_birth date
  gender enum [note: 'male, female, other']
  pickup_address_id ObjectId [not null, ref: > parent_addresses._id]
  emergency_contact varchar(20)
  medical_info text
  is_active boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    parent_id
    school_id
    is_active
  }
}

Table driver_student_assignments {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  driver_id ObjectId [not null, ref: > drivers._id]
  student_id ObjectId [not null, ref: > students._id]
  driver_unique_id varchar(20) [not null, note: 'Unique ID parents use to find driver']
  monthly_fee decimal(10,2)
  assignment_status enum [default: 'pending', note: 'active, inactive, pending, parent_requested']
  assignment_source enum [default: 'parent', note: 'parent or school - indicates assignment source']
  assigned_by ObjectId [note: 'References parents._id or admin_portal._id depending on assignment_source']
  assigned_date date [not null]
  start_date date
  end_date date
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    driver_id
    student_id
    assignment_status
    (driver_id, assignment_status)
    driver_unique_id
  }

  Note: 'Parents or schools assign drivers to students. assignment_source tracks who assigned (parent or school).'
}

Table trips {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  driver_id ObjectId [not null, ref: > drivers._id]
  school_id ObjectId [not null, ref: > schools._id, note: 'Destination school for pickup, start point for drop']
  trip_type enum [not null, note: 'pickup, drop']
  trip_date date [not null]
  trip_status enum [default: 'scheduled', note: 'scheduled, started, in_progress, completed, cancelled']
  start_time timestamp
  end_time timestamp
  total_distance decimal(10,2) [note: 'in kilometers']
  optimized_route_data json [note: 'Calculated optimal sequence of student pickups/drops based on lat/long']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    (driver_id, trip_date)
    trip_status
    trip_date
    school_id
  }

  Note: 'Route is dynamically calculated: Driver home → Students (optimized order) → School (pickup) OR School → Students (optimized order) → Driver home (drop)'
}

Table trip_students {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  trip_id ObjectId [not null, ref: > trips._id]
  student_id ObjectId [not null, ref: > students._id]
  sequence_order int [note: 'Optimized pickup/drop order calculated by system based on lat/long']
  estimated_arrival_time time [note: 'Calculated ETA based on route optimization']
  attendance_status enum [default: 'pending', note: 'present, absent, pending']
  pickup_status enum [default: 'pending', note: 'pending, picked, dropped, no_show']
  pickup_time timestamp
  pickup_latitude decimal(10,8)
  pickup_longitude decimal(11,8)
  pickup_qr_code varchar(100)
  pickup_otp varchar(6)
  drop_time timestamp
  drop_latitude decimal(10,8)
  drop_longitude decimal(11,8)
  drop_qr_code varchar(100)
  drop_otp varchar(6)
  notes text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    trip_id
    student_id
    (attendance_status, pickup_status)
    (trip_id, sequence_order)
  }

  Note: '''sequence_order is auto-calculated using routing algorithm based on student home addresses and school location.

  Bulk Stop Action (POST /trip-students/trip/:tripId/bulk-stop-action):
  - Works for both PICKUP (morning) and DROP (evening) trips based on trip.trip_type
  - Request body: student_ids[], absent_student_ids[], otp_code/qr_code, latitude, longitude
  - PICKUP trip: sets pickup_status=PICKED, pickup_time, pickup_lat/long
  - DROP trip: validates PICKED status, sets pickup_status=DROPPED, drop_time, drop_lat/long
  - Updates daily_qr_otp verified_student_ids/absent_student_ids
  - OTP required only for pickup/drop, not for marking absent

  Bulk School Action (POST /trip-students/trip/:tripId/bulk-school-action):
  - Used at school location - NO OTP required
  - Request body: student_ids[], latitude, longitude
  - PICKUP trip: marks PICKED students as DROPPED at school (drop_time, drop_lat/long)
  - DROP trip: marks PENDING students as PICKED from school (pickup_time, pickup_lat/long)

  Complete Flow:
  PICKUP (morning): bulk-stop-action at home (OTP) → bulk-school-action at school (no OTP)
  DROP (evening): bulk-school-action at school (no OTP) → bulk-stop-action at home (OTP)'''
}

Table location_tracking {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  trip_id ObjectId [not null, ref: > trips._id]
  driver_id ObjectId [not null, ref: > drivers._id]
  latitude decimal(10,8) [not null]
  longitude decimal(11,8) [not null]
  speed decimal(5,2) [note: 'in km/h']
  heading decimal(5,2) [note: 'direction in degrees']
  accuracy decimal(6,2) [note: 'in meters']
  timestamp timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    trip_id
    driver_id
    timestamp
  }
}

Table daily_qr_otp {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  parent_id ObjectId [not null, ref: > parents._id, note: 'One OTP per parent per trip']
  student_ids json [not null, note: 'Array of student ObjectIds covered by this OTP']
  trip_id ObjectId [not null, ref: > trips._id]
  qr_code varchar(255) [unique, not null]
  otp_code varchar(6) [not null]
  trip_type enum [not null, note: 'pickup, drop']
  valid_from timestamp [not null]
  valid_until timestamp [not null]
  is_used boolean [default: false]
  used_at timestamp
  verified_student_ids json [note: 'Students who were picked up/dropped via bulk-stop-action or individual pickup']
  absent_student_ids json [note: 'Students marked absent via bulk-stop-action or markAttendance']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (parent_id, trip_id)
    qr_code
    otp_code
    valid_until
  }

  Note: '''Parent-grouped OTP: One OTP covers all children of same parent in a trip.
  Updated by:
  - bulk-stop-action: student_ids → verified_student_ids, absent_student_ids → absent_student_ids
  - Individual pickup/drop: adds to verified_student_ids
  - markAttendance(absent): adds to absent_student_ids
  is_used becomes true when all student_ids are in verified_student_ids OR absent_student_ids'''
}

Table notifications {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  user_id ObjectId [not null, ref: > users._id]
  notification_type enum [not null, note: 'pickup_started, approaching, picked_up, dropped, absent, trip_started, trip_completed, payment_due, general']
  title varchar(200) [not null]
  message text [not null]
  data json [note: 'Additional data']
  is_read boolean [default: false]
  read_at timestamp
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, is_read)
    created_at
  }
}

Table device_tokens {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  user_id ObjectId [not null, ref: > users._id]
  role varchar(20) [not null, note: 'parent, driver, school_admin, admin, superadmin']
  fcm_token varchar(500) [not null, note: 'Firebase Cloud Messaging registration token']
  device_type enum [not null, note: 'android, ios, web']
  device_id varchar(255) [not null, note: 'Stable device identifier (Android ID, iOS identifierForVendor)']
  is_active boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    (user_id, is_active)
    fcm_token [unique]
    (user_id, device_id)
  }

  Note: '''Multi-device support: one record per (user, device). A user can have multiple active tokens (e.g., mom phone + dad phone).

  Upsert logic:
  1. Same user + same device_id → update fcm_token (handles token refresh)
  2. Same fcm_token, different user → update user/device info (device changed hands)
  3. New device + new token → create new record

  Deactivated (is_active=false) on logout or when FCM reports token invalid.'''
}

Table notification_preferences {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  user_id ObjectId [unique, not null, ref: > users._id]
  push_enabled boolean [default: true, note: 'Global on/off toggle for FCM push notifications']
  updated_at timestamp

  indexes {
    user_id [unique]
  }

  Note: '''One record per user. Controls whether FCM push notifications are sent.
  When push_enabled=false, FCM is skipped but Socket.IO events and DB notification records are still created.
  If no record exists for a user, push is enabled by default.'''
}

Table subscription_plans {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  plan_name varchar(100) [not null]
  plan_type enum [not null, note: 'monthly, quarterly, yearly']
  price decimal(10,2) [not null]
  features json
  is_active boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    is_active
  }
}

Table parent_subscriptions {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  parent_id ObjectId [not null, ref: > parents._id]
  plan_id ObjectId [not null, ref: > subscription_plans._id]
  start_date date [not null]
  end_date date [not null]
  subscription_status enum [not null, note: 'active, expired, cancelled']
  auto_renew boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    parent_id
    subscription_status
    end_date
  }
}

Table school_subscriptions {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  school_id ObjectId [not null, ref: > schools._id]
  plan_id ObjectId [not null, ref: > subscription_plans._id]
  start_date date [not null]
  end_date date [not null]
  subscription_status enum [not null, note: 'active, expired, cancelled, pending']
  auto_renew boolean [default: false]
  max_drivers int [note: 'Maximum drivers allowed under this subscription']
  max_students int [note: 'Maximum students allowed under this subscription']
  billing_contact varchar(100) [note: 'Contact person for billing']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    school_id
    subscription_status
    end_date
  }

  Note: 'School-level subscription. Per-student redemption codes are in school_student_codes table.'
}

Table school_student_codes {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  code varchar(50) [unique, not null, note: 'Redemption code prefixed with SCHSTDCD']
  school_subscription_id ObjectId [not null, ref: > school_subscriptions._id]
  school_id ObjectId [not null, ref: > schools._id]
  student_id ObjectId [not null, ref: > students._id]
  plan_id ObjectId [not null, ref: > subscription_plans._id]
  end_date date [not null]
  is_redeemed boolean [default: false]
  redeemed_by_parent_id ObjectId [ref: > parents._id, note: 'Parent who redeemed this code']
  redeemed_at timestamp
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    school_subscription_id
    school_id
    student_id
    code
    is_redeemed
    (school_subscription_id, student_id)
  }

  Note: 'Per-student redemption codes generated by school admin. Parent redeems code in app to activate subscription.'
}

Table payments {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  parent_id ObjectId [not null, ref: > parents._id]
  payment_type enum [not null, note: 'subscription, penalty']
  amount decimal(10,2) [not null]
  currency varchar(3) [default: 'INR']
  payment_method enum [not null, note: 'card, upi, netbanking, wallet, cash']
  payment_status enum [not null, note: 'pending, completed, failed, refunded']
  transaction_id varchar(100)
  gateway_response json
  subscription_id ObjectId [ref: > parent_subscriptions._id]
  payment_date timestamp [default: `CURRENT_TIMESTAMP`]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    parent_id
    payment_status
    payment_date
  }

  Note: 'Only parents make payments for subscriptions and penalties. No driver payments.'
}

Table ratings_reviews {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  parent_id ObjectId [not null, ref: > parents._id]
  driver_id ObjectId [not null, ref: > drivers._id]
  trip_id ObjectId [ref: > trips._id]
  rating int [not null, note: '1-5 stars']
  review_text text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    driver_id
    rating
  }
}

Table support_tickets {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  user_id ObjectId [not null, ref: > users._id]
  subject varchar(200) [not null]
  description text [not null]
  ticket_status enum [default: 'open', note: 'open, in_progress, resolved, closed']
  priority enum [default: 'medium', note: 'low, medium, high, urgent']
  assigned_to ObjectId [note: 'References admin_portal._id']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp
  resolved_at timestamp

  indexes {
    user_id
    ticket_status
    created_at
  }
}

Table audit_logs {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  user_id ObjectId [ref: > users._id]
  action_type varchar(50) [not null]
  entity_type varchar(50) [not null]
  entity_id ObjectId
  old_values json
  new_values json
  ip_address varchar(45)
  user_agent text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    user_id
    (entity_type, entity_id)
    created_at
  }
}

Table admin_portal {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  username varchar(100) [unique, not null]
  password_hash varchar(255) [not null]
  email varchar(100) [unique, not null]
  phone_number varchar(20)
  admin_role enum [not null, note: 'superadmin, admin, school_admin']
  school_id ObjectId [ref: > schools._id, note: 'Required for school_admin role only']
  is_active boolean [default: true]
  last_login timestamp
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    username
    email
    admin_role
    school_id
    is_active
  }

  Note: 'Single admin collection for all admin roles. superadmin/admin managed via /admin/setup and /admin endpoints. school_admin requires school_id and can only be created by superadmin or admin. Creation hierarchy: superadmin → admin, school_admin | admin → school_admin only.'
}

Table ads {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  title varchar(200) [not null]
  description text
  media_url varchar(500) [not null, note: 'Image or video URL from storage']
  media_type enum [not null, note: 'image, video']
  ad_type enum [not null, note: 'banner, interstitial, native_card']
  target_audience enum [not null, default: 'all', note: 'all, parents, drivers, school_admin']
  target_school_ids json [note: 'Array of school ObjectIds; null = show to all schools']
  click_action_type enum [note: 'url, in_app_screen, none']
  click_url varchar(500) [note: 'External URL or in-app deep-link on tap']
  advertiser_name varchar(200)
  start_date date [not null]
  end_date date [not null]
  is_active boolean [default: true]
  display_frequency int [default: 1, note: 'Max times shown per user per day']
  priority int [default: 0, note: 'Higher value = shown first when multiple ads qualify']
  impression_count int [default: 0, note: 'Denormalized total impressions']
  click_count int [default: 0, note: 'Denormalized total clicks']
  created_by ObjectId [not null, ref: > admin_portal._id]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    is_active
    target_audience
    (start_date, end_date)
    priority
  }

  Note: 'Ads created by superadmin/admin. target_school_ids=null means all schools. Frequency and priority control delivery logic.'
}

Table ad_interactions {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  ad_id ObjectId [not null, ref: > ads._id]
  user_id ObjectId [not null, ref: > users._id]
  interaction_type enum [not null, note: 'impression, click, dismiss']
  screen_context varchar(100) [note: 'Screen where ad appeared, e.g. home, trip_active']
  timestamp timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    ad_id
    user_id
    (ad_id, user_id, timestamp)
    interaction_type
  }

  Note: 'One row per interaction event. Used to enforce display_frequency cap and for ad analytics.'
}

Table school_events {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  school_id ObjectId [not null, ref: > schools._id]
  created_by ObjectId [not null, ref: > admin_portal._id, note: 'school_admin who created the event']
  event_title varchar(200) [not null]
  event_description text
  event_type enum [not null, note: 'sports, parent_meeting, cultural, holiday, festival, exam, excursion, general']
  event_date date [not null]
  end_date date [note: 'For multi-day events (exam week, holiday block); null = single day']
  start_time varchar(10) [note: 'HH:MM; null for all-day events like holidays']
  end_time varchar(10) [note: 'HH:MM format']
  venue varchar(255)
  audience_scope enum [not null, default: 'all', note: 'all, class_specific']
  target_classes json [note: 'Array of class strings e.g. ["10A","10B"] when audience_scope=class_specific']
  is_mandatory boolean [default: false]
  requires_rsvp boolean [default: false]
  rsvp_deadline date [note: 'Required when requires_rsvp=true']
  attachment_urls json [note: 'Array of circular/PDF/image URLs']
  is_cancelled boolean [default: false]
  cancellation_reason text
  notification_sent boolean [default: false, note: 'True after push notification dispatched to affected parents']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    school_id
    event_type
    event_date
    (school_id, event_date)
    audience_scope
    is_cancelled
  }

  Note: 'School admins create events visible to parents of that school. audience_scope controls which parents see it. Notifications auto-dispatched on publish.'
}

Table event_rsvp {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  event_id ObjectId [not null, ref: > school_events._id]
  parent_id ObjectId [not null, ref: > parents._id]
  student_id ObjectId [not null, ref: > students._id, note: 'Child this RSVP is for (matters for class-specific events)']
  rsvp_status enum [not null, note: 'attending, not_attending, maybe']
  notes text [note: 'Optional parent message']
  responded_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    event_id
    parent_id
    (event_id, parent_id, student_id)
    rsvp_status
  }

  Note: 'One RSVP per (event, parent, student). Only relevant when school_events.requires_rsvp=true.'
}

Table school_parent_community {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  school_id ObjectId [not null, ref: > schools._id]
  parent_id ObjectId [not null, ref: > parents._id]
  is_active boolean [default: true, note: 'Set false when parent has no active student in this school']
  notification_preferences json [note: '{ posts: bool, events: bool, announcements: bool }']
  joined_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    school_id
    parent_id
    (school_id, parent_id)
    is_active
  }

  Note: 'Auto-created when parent adds a student to a school. One membership per (school, parent). Gates access to community board and event notifications for that school.'
}

Table parent_connections {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  requester_id ObjectId [not null, ref: > parents._id]
  recipient_id ObjectId [not null, ref: > parents._id]
  school_id ObjectId [not null, ref: > schools._id, note: 'Shared school through which connection was initiated']
  connection_status enum [not null, default: 'pending', note: 'pending, accepted, rejected, blocked']
  connected_at timestamp [note: 'Populated when status changes to accepted']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    requester_id
    recipient_id
    (requester_id, recipient_id)
    school_id
    connection_status
  }

  Note: 'Opt-in connection between two parents sharing a school. Unique pair (requester, recipient). A blocked record prevents future requests from that pair.'
}

Table community_posts {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  school_id ObjectId [not null, ref: > schools._id]
  author_parent_id ObjectId [not null, ref: > parents._id]
  post_content text [not null]
  media_urls json [note: 'Array of image/video URLs']
  post_type enum [not null, default: 'general', note: 'general, question, alert, recommendation']
  is_anonymous boolean [default: false, note: 'Hides author from other parents; admin can still see']
  is_pinned boolean [default: false]
  pinned_by ObjectId [ref: > admin_portal._id]
  is_visible boolean [default: true, note: 'Set false by admin to moderate/remove post']
  moderated_by ObjectId [ref: > admin_portal._id]
  moderation_reason text
  reaction_count int [default: 0, note: 'Denormalized total reactions']
  comment_count int [default: 0, note: 'Denormalized total comments']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    school_id
    author_parent_id
    post_type
    (school_id, is_visible, created_at)
    is_pinned
  }

  Note: 'Community board posts visible to all parents with active membership in school_parent_community. School admins can moderate and pin posts.'
}

Table community_post_reactions {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  post_id ObjectId [not null, ref: > community_posts._id]
  parent_id ObjectId [not null, ref: > parents._id]
  reaction_type enum [not null, note: 'like, helpful, heart, support']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    post_id
    parent_id
    (post_id, parent_id)
  }

  Note: 'One reaction per (post, parent). Upsert on type change; delete to remove. Increments/decrements community_posts.reaction_count.'
}

Table community_post_comments {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  post_id ObjectId [not null, ref: > community_posts._id]
  parent_id ObjectId [not null, ref: > parents._id]
  comment_text text [not null]
  is_anonymous boolean [default: false]
  is_visible boolean [default: true]
  moderated_by ObjectId [ref: > admin_portal._id]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    post_id
    parent_id
    (post_id, is_visible, created_at)
  }

  Note: 'Flat (non-nested) comments. Increments/decrements community_posts.comment_count on create/delete.'
}

Table roles {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  role_name varchar(50) [unique, not null, note: 'parent, driver, superadmin, admin, support']
  description text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp
}

Table user_roles {
  _id ObjectId [pk, note: 'MongoDB auto-generated']
  user_id ObjectId [not null, ref: > users._id]
  role_id ObjectId [not null, ref: > roles._id]
  assigned_by ObjectId [ref: > admin_portal._id]
  assigned_at timestamp [default: `CURRENT_TIMESTAMP`]
  is_active boolean [default: true]

  indexes {
    user_id
    role_id
    is_active
  }

  Note: 'Maps users to roles (parent, driver, admin, etc). Admins can assign roles.'
}
